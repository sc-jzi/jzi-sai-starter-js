# harness/env.example — copy to harness/.env.local (git-ignored) and fill in. One place for everything the harness needs.
# Never commit the real file. Values are never printed by any harness script.

# --- Sitecore (SitecoreAI Deploy > Credentials > Environment > create an AUTOMATION client) ---
SITECORE_AUTOMATION_CLIENT_ID=
SITECORE_AUTOMATION_CLIENT_SECRET=
# The authoring (CM) environment id. Pins the environment the Sites API talks to and is used to create each demo's editing host
SITECORE_ENVIRONMENT_ID=
# Optional: site template to create new sites from (list them: node harness/scripts/sites-api.mjs templates)
SITE_TEMPLATE_ID=
SITECORE_DEFAULT_LANGUAGE=en

# --- Copied into each demo app's own .env.local when the app is created ---
SITECORE_EDGE_CONTEXT_ID=
NEXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID=
SITECORE_EDITING_SECRET=
# Design Library (optional)
SITECORE_AUTH_CLIENT_ID=
SITECORE_AUTH_CLIENT_SECRET=

# --- Content Hub (images). CH_ENABLED=false -> images-to-upload.md is written instead ---
CH_ENABLED=false
CH_HOST=
CH_AUTH_METHOD=simple
CH_USER=
CH_PASSWORD=
CH_CLIENT_ID=
CH_CLIENT_SECRET=
CH_UPLOAD_CONFIG=AssetUploadConfiguration

# --- Harness behaviour ---
# App every new demo is copied FROM (read-only, never edited). Default: prospera
BASE_APP_FOLDER=prospera
# Existing rendering host in xmcloud.build.json whose settings are cloned for each demo
RENDERING_HOST_TEMPLATE=basic-nextjs
# Extra folders under industry-verticals/ and site names that must never be touched (comma separated)
PROTECTED_FOLDERS=
PROTECTED_SITES=
