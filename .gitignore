# may contain OAuth secrets, do not commit
.sitecore/user.json

# NuGet cache for Sitecore CLI
.sitecore/package-cache/

# Ephemeral index caches used by serialization, do not commit
.scindex

# Don't commit packages
*.itempackage
*.sicpackage


#Ignore thumbnails created by Windows
Thumbs.db
#Ignore files built by Visual Studio
*.obj
*.exe
*.pdb
*.user
*.aps
*.pch
*.vspscc
*_i.c
*_p.c
*.ncb
*.suo
*.tlb
*.tlh
*.bak
*.cache
*.ilk
*.log
[Bb]in
[Dd]ebug*/
*.lib
*.sbr
obj/
[Rr]elease*/
_ReSharper*/
[Tt]est[Rr]esult*
.vs/
#Nuget packages folder
packages/

#Ignore system files
.DS_Store

# VS Code settings
.vscode/

# ---- demo harness: secrets, transcripts, generated working files (never commit) ----
# harness settings and credentials
harness/.env.local
# discovery transcripts (Gong exports) waiting to be taken in
harness/inbox/*
!harness/inbox/README.md
# EVERYTHING a demo produces about the opportunity (transcript, brief, story, plan, script, theme draft, site ids, progress, captures)
# stays on the SE's machine. The customer's APP CODE next to it (src/, .sitecore/, ...) is committed as usual.
industry-verticals/*/docs/ai/demos/
# transcripts and raw call material anywhere else
**/discovery-transcript.*
*.vtt
*.srt
# credentials and local env of the base app and every demo app
**/docs/ai/config/credentials.local.yaml
.env
.env.local
.env.*.local
# theme scrapes of a customer's site that were saved into an app's themes folder
industry-verticals/*/docs/ai/themes/*/screenshot-*.png

# installed packages (harness/node_modules, any app)
node_modules/
harness/package-lock.json
