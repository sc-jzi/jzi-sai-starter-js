      {
        "name": "Is Block Storage the same as Object Storage",
        "fields": [
          {
            "name": "Question",
            "value": "Is Block Storage the same as Object Storage?"
          },
          {
            "name": "Answer",
            "value": "<p>No — Block Storage is attachable volumes; Object Storage is S3-compatible object buckets.</p>"
          }
        ]
      },
