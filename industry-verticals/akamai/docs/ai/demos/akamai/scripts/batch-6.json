        "name": "What resources can Cloud Firewall protect",
        "fields": [
          {
            "name": "Question",
            "value": "What resources can Cloud Firewall protect?"
          },
          {
            "name": "Answer",
            "value": "<p>Linode instances and NodeBalancers.</p>"
          }
        ]
      },
      {
        "name": "Is it a WAF",
        "fields": [
          {
            "name": "Question",
            "value": "Is it a WAF?"
          },
          {
            "name": "Answer",
            "value": "<p>No — Cloud Firewall is network-layer filtering; pair with WAAP/API Security for app-layer threats.</p>"
          }
        ]
      },
      {
        "name": "Does it cost extra",
        "fields": [
          {
            "name": "Question",
            "value": "Does it cost extra?"
          },
          {
            "name": "Answer",
            "value": "<p>Cloud Firewall is included with Akamai Cloud networking.</p>"
          }
        ]
      }
