        "fields": [
          {
            "name": "Question",
            "value": "Shared vs dedicated CPU?"
          },
          {
            "name": "Answer",
            "value": "<p>Shared maximizes value; dedicated guarantees CPU resources for noisier neighbors.</p>"
          }
        ]
      },
      {
        "name": "Can I run containers",
        "fields": [
          {
            "name": "Question",
            "value": "Can I run containers?"
          },
          {
            "name": "Answer",
            "value": "<p>Yes — run Docker directly or use managed Kubernetes.</p>"
          }
        ]
      },
      {
        "name": "How do GPUs differ",
        "fields": [
          {
            "name": "Question",
            "value": "How do GPUs differ?"
          },
          {
            "name": "Answer",
            "value": "<p>GPUs accelerate AI/ML and parallel workloads; CPU suits general apps.</p>"
