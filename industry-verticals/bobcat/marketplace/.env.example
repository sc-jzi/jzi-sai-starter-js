# Product Enrichment Marketplace app (catalog plan section 7). Copy to .env.local; never commit .env.local.
# Public API of the PIM (Xano standing in for Product Data Digger); read on the app's server only
PIM_API_URL=https://x8ki-letl-twmt.n7.xano.io/api:product-pim
# The Bobcat site the app previews and revalidates (localhost dev server, or the Vercel URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3010
# Same value as the site's PIM_REVALIDATE_SECRET (not needed against a local site dev server)
PIM_REVALIDATE_SECRET=
# Cloudinary Media Library widget (social image picker): cloud name and API key from the Cloudinary console (Settings > API Keys).
# Both are public; the API secret is never needed. Authors sign in to Cloudinary inside the widget.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
